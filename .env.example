# Copy to .env.local and fill in. Server-only values; never prefix with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Neon Managed Better Auth (Console > Branch > Auth > Configuration)
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth"
# At least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# Anthropic API key for the AI assistant (server only; never NEXT_PUBLIC_).
ANTHROPIC_API_KEY=""

# Server-only HMAC key for anonymous assistant session integrity and pseudonymous rate-limit keys.
# Generate a unique random value of at least 32 characters; never prefix with NEXT_PUBLIC_.
CHAT_SESSION_SECRET=""

# Server-only Vercel Cron authorization for /api/cron/cleanup-chat. Generate a unique random value of at least 32 characters.
CRON_SECRET=""
