          "value": "\"food_requests\".\"window_end\" > \"food_requests\".\"window_start\""
        },
        "claim_status_consistency": {
          "name": "claim_status_consistency",
          "value": "(\"food_requests\".\"status\" = 'open' AND \"food_requests\".\"claimed_by\" IS NULL)\n        OR (\"food_requests\".\"status\" IN ('claimed', 'delivered') AND \"food_requests\".\"claimed_by\" IS NOT NULL)\n        OR (\"food_requests\".\"status\" = 'cancelled' AND \"food_requests\".\"claimed_by\" IS NULL)"
        }
